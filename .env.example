# ---------------------------------------------------------------------------
# Database (PostgreSQL). For local development you can use any Postgres server
# or the embedded Postgres helper described in DOCUMENTATION/06_Setup_and_Testing.md
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cmo_grievance?schema=public"

# Direct (non-pooled) connection used by Prisma Migrate.
# Locally this can be the same as DATABASE_URL. On Neon/Vercel use the
# unpooled connection string here and the pooled string for DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cmo_grievance?schema=public"

# ---------------------------------------------------------------------------
# Authentication - generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-characters"

# ---------------------------------------------------------------------------
# AI Grievance Assistant (OpenAI-compatible chat completions endpoint)
# Works with OpenAI, Groq, OpenRouter, Google Gemini (OpenAI compatibility),
# Together AI or a local Ollama server. Leave AI_API_KEY empty to run the
# clearly-labelled deterministic fallback analyser.
# ---------------------------------------------------------------------------
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_TIMEOUT_MS="15000"

# Examples:
#   Groq      AI_BASE_URL="https://api.groq.com/openai/v1"          AI_MODEL="llama-3.3-70b-versatile"
#   Gemini    AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"  AI_MODEL="gemini-2.0-flash"
#   OpenRouter AI_BASE_URL="https://openrouter.ai/api/v1"           AI_MODEL="meta-llama/llama-3.3-70b-instruct:free"
#   Ollama    AI_BASE_URL="http://localhost:11434/v1"               AI_MODEL="llama3.1"

# ---------------------------------------------------------------------------
# One-time demo data seeding endpoint (POST /api/admin/seed with header
# x-seed-token). Change this to any long random value before deploying.
# ---------------------------------------------------------------------------
SEED_TOKEN="change-this-seed-token"

# Set to "true" to allow the seed endpoint. Remove or set to "false" after seeding.
ALLOW_DEMO_SEED="true"

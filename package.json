{
  "name": "cm-kerala-grievance-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Chief Minister's Public Grievance Redressal Portal for Kerala - independent demonstration",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "tsc -p tests/tsconfig.json && node --test \".test-build/tests/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "jose": "6.2.17",
    "lucide-react": "1.72.0",
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "3.10.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.2.3",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
